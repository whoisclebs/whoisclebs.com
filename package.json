{
  "name": "whoisclebs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/validate-editorial.mjs && node scripts/verify-locale-parity.mjs && node scripts/build-og.mjs && vite build && node scripts/optimize-images.mjs .svelte-kit/cloudflare && node scripts/verify-publishing.mjs .svelte-kit/cloudflare",
    "preview": "wrangler dev --port 8787",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "snapshots": "node scripts/capture-snapshots.mjs",
    "validate:editorial": "node scripts/validate-editorial.mjs",
    "validate:locale": "node scripts/verify-locale-parity.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "prepare": "svelte-kit sync || echo ''; husky",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check:island": "node scripts/check-island-budget.mjs",
    "verify:publishing": "node scripts/verify-publishing.mjs .svelte-kit/cloudflare"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@jsonresume/schema": "1.3.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "marked": "^18.0.14",
    "sharp": "^0.34.5",
    "shiki": "^4.4.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.141.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "flatted": "3.4.2"
  }
}
