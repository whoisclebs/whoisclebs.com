{
  "name": "whoisclebs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/validate-editorial.mjs && node scripts/verify-locale-parity.mjs && node scripts/build-og.mjs && vite build && node scripts/optimize-images.mjs .svelte-kit/cloudflare && node scripts/verify-publishing.mjs .svelte-kit/cloudflare",
    "preview": "node scripts/wrangler-dev-config.mjs && wrangler dev --config wrangler.dev.jsonc --port 8787",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "snapshots": "node scripts/capture-snapshots.mjs",
    "validate:editorial": "node scripts/validate-editorial.mjs",
    "validate:locale": "node scripts/verify-locale-parity.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "prepare": "svelte-kit sync || echo ''; husky",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check:island": "node scripts/check-island-budget.mjs",
    "verify:publishing": "node scripts/verify-publishing.mjs .svelte-kit/cloudflare",
    "check:budgets": "node scripts/check-budgets.mjs",
    "lhci": "node scripts/run-lhci.mjs",
    "verify": "npm run check && npm run lint && npm test && npm run test:integration && npm run build && npm run test:e2e && npm run check:contrast && npm run check:island && npm run check:budgets && npm run lhci"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cfworker/json-schema": "4.1.6",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@jsonresume/schema": "1.7.0",
    "@lhci/cli": "^0.16.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "marked": "^18.1.3",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.5",
    "wrangler": "^4.158.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "flatted": "3.4.2"
  }
}
