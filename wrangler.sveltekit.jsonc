// Usado só pelo @sveltejs/adapter-cloudflare no build (svelte.config.js → adapter({ config })).
// O adapter grava o Worker do SvelteKit em `main`; a entrada real do deploy é `src/worker.ts`
// (wrangler.jsonc), que importa este arquivo pelo alias `sveltekit-worker`. Mantenha `assets` igual.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whoisclebs",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  }
}
